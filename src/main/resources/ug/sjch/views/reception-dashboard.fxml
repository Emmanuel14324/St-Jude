<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ug.sjch.controller.ReceptionDashboardController"
            styleClass="dashboard-shell reception-shell">
    <left>
        <StackPane>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="238" spacing="6">
            <HBox styleClass="sidebar-brand" spacing="10">
                <Label text="✚" styleClass="sidebar-logo"/>
                <VBox>
                    <Label text="ST JUDE" styleClass="sidebar-name"/>
                    <Label text="CENTRAL HOSPITAL" styleClass="sidebar-caption"/>
                </VBox>
            </HBox>

            <Label text="RECEPTION" styleClass="nav-section"/>
            <Button fx:id="dashboardButton"
                    text="▦   Dashboard"
                    styleClass="nav-button, nav-button-active"
                    onAction="#handleDashboard"/>
            <Button fx:id="registerPatientButton"
                    text="♙   Register New Patient"
                    styleClass="nav-button"
                    onAction="#handleRegisterPatient"/>
            <Button fx:id="patientDirectoryButton"
                    text="▤   Patient Directory"
                    styleClass="nav-button"
                    onAction="#handlePatientDirectory"/>
            <Button fx:id="bookAppointmentButton"
                    text="▣   Book Appointment"
                    styleClass="nav-button"
                    onAction="#handleBookAppointment"/>
            <Button fx:id="appointmentScheduleButton"
                    text="▦   Appointment Schedule"
                    styleClass="nav-button"
                    onAction="#handleAppointmentSchedule"/>
            <Button fx:id="patientCheckInButton"
                    text="◷   Patient Check-in"
                    styleClass="nav-button"
                    onAction="#handlePatientCheckIn"/>
            <Button fx:id="patientSearchButton"
                    text="⌕   Patient Search"
                    styleClass="nav-button"
                    onAction="#handlePatientSearch"/>
            <Button fx:id="notificationsButton"
                    text="♢   Notifications"
                    styleClass="nav-button"
                    onAction="#handleNotifications"/>

            <Region VBox.vgrow="ALWAYS"/>
            <HBox styleClass="sidebar-user" spacing="10">
                <Label text="SJ" styleClass="avatar"/>
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="sidebarUserLabel"
                           styleClass="sidebar-user-name"/>
                    <Label text="Receptionist"
                           styleClass="sidebar-user-status"/>
                </VBox>
            </HBox>
            <Button text="⇥   Sign out" styleClass="logout-button"
                    onAction="#handleLogout"/>
        </VBox>
        <Region fx:id="sidebarResizeHandle"
                styleClass="sidebar-resize-handle"
                StackPane.alignment="CENTER_RIGHT"/>
        </StackPane>
    </left>

    <center>
        <VBox styleClass="workspace">
            <HBox styleClass="topbar reception-topbar"
                  alignment="CENTER_LEFT" spacing="14">
                <Label text="Reception" styleClass="reception-top-title"/>
                <TextField fx:id="searchField"
                           promptText="Search patients and appointments..."
                           styleClass="top-search" HBox.hgrow="ALWAYS"/>
                <Button text="↻" styleClass="reception-refresh-button"
                        onAction="#handleRefresh"/>
                <Label text="●" styleClass="notification-icon"/>
                <Label text="RC" styleClass="reception-profile-dot"/>
                <VBox spacing="1">
                    <Label fx:id="topUserLabel"
                           styleClass="top-user-name"/>
                    <Label text="Receptionist"
                           styleClass="top-user-role"/>
                </VBox>
            </HBox>

            <ScrollPane fx:id="contentScroll"
                        fitToWidth="true" styleClass="dashboard-scroll"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="dashboardContent"
                          styleClass="dashboard-content reception-content"
                          spacing="14">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox HBox.hgrow="ALWAYS" spacing="3">
                                <Label fx:id="welcomeLabel"
                                       text="Reception &amp; Patient Registration"
                                       styleClass="page-title"/>
                                <Label fx:id="dateLabel"
                                       styleClass="page-subtitle"/>
                            </VBox>
                            <Label fx:id="statusLabel" text="Loading..."
                                   styleClass="status-badge"/>
                        </HBox>

                        <GridPane fx:id="metricGrid"
                                  styleClass="metrics-grid" hgap="16" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>
                        </GridPane>

                        <VBox styleClass="panel reception-queue-panel"
                              spacing="10">
                            <HBox alignment="CENTER_LEFT">
                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="Today's appointment flow"
                                           styleClass="panel-title"/>
                                    <Label text="Live progress through reception and consultation"
                                           styleClass="panel-hint"/>
                                </VBox>
                                <Label fx:id="workflowTotalLabel"
                                       text="0 appointments"
                                       styleClass="table-count-badge"/>
                            </HBox>
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <VBox styleClass="workflow-step" HBox.hgrow="ALWAYS"
                                      spacing="5">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Queue" styleClass="workflow-title queue-color"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="queuedCountLabel" text="0"
                                               styleClass="workflow-count"/>
                                    </HBox>
                                    <ProgressBar fx:id="queuedProgress"
                                                 progress="0"
                                                 styleClass="workflow-progress queue-progress"
                                                 maxWidth="Infinity"/>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Scheduled" styleClass="workflow-caption"
                                               HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="queuedPercentLabel" text="0%"
                                               styleClass="workflow-percent queue-percent"/>
                                    </HBox>
                                </VBox>
                                <VBox styleClass="workflow-step" HBox.hgrow="ALWAYS"
                                      spacing="5">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Waiting" styleClass="workflow-title waiting-color"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="waitingCountLabel" text="0"
                                               styleClass="workflow-count"/>
                                    </HBox>
                                    <ProgressBar fx:id="waitingProgress"
                                                 progress="0"
                                                 styleClass="workflow-progress waiting-progress"
                                                 maxWidth="Infinity"/>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Checked in" styleClass="workflow-caption"
                                               HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="waitingPercentLabel" text="0%"
                                               styleClass="workflow-percent waiting-percent"/>
                                    </HBox>
                                </VBox>
                                <VBox styleClass="workflow-step" HBox.hgrow="ALWAYS"
                                      spacing="5">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Engaged" styleClass="workflow-title engaged-color"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="engagedCountLabel" text="0"
                                               styleClass="workflow-count"/>
                                    </HBox>
                                    <ProgressBar fx:id="engagedProgress"
                                                 progress="0"
                                                 styleClass="workflow-progress engaged-progress"
                                                 maxWidth="Infinity"/>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="In consultation" styleClass="workflow-caption"
                                               HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="engagedPercentLabel" text="0%"
                                               styleClass="workflow-percent engaged-percent"/>
                                    </HBox>
                                </VBox>
                                <VBox styleClass="workflow-step" HBox.hgrow="ALWAYS"
                                      spacing="5">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Done" styleClass="workflow-title done-color"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="completedCountLabel" text="0"
                                               styleClass="workflow-count"/>
                                    </HBox>
                                    <ProgressBar fx:id="completedProgress"
                                                 progress="0"
                                                 styleClass="workflow-progress done-progress"
                                                 maxWidth="Infinity"/>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Completed" styleClass="workflow-caption"
                                               HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="completedPercentLabel" text="0%"
                                               styleClass="workflow-percent done-percent"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>

                        <HBox spacing="12" styleClass="reception-table-row">
                            <VBox styleClass="panel reception-table-panel"
                                  HBox.hgrow="ALWAYS" spacing="8">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Recently registered patients"
                                               styleClass="panel-title"/>
                                        <Label text="Latest additions to the patient directory"
                                               styleClass="panel-hint"/>
                                    </VBox>
                                    <Label fx:id="recentPatientCountLabel"
                                           text="0 records"
                                           styleClass="table-count-badge"/>
                                </HBox>
                                <TableView fx:id="patientTable"
                                           styleClass="dashboard-table reception-table"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="patientNumberColumn"
                                                     text="Patient No."
                                                     prefWidth="105"/>
                                        <TableColumn fx:id="patientNameColumn"
                                                     text="Patient name"
                                                     prefWidth="150"/>
                                        <TableColumn fx:id="patientPhoneColumn"
                                                     text="Phone"
                                                     prefWidth="110"/>
                                        <TableColumn fx:id="patientRegisteredColumn"
                                                     text="Registered"
                                                     prefWidth="140"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox styleClass="panel reception-table-panel"
                                  HBox.hgrow="ALWAYS" spacing="8">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Upcoming appointments"
                                               styleClass="panel-title"/>
                                        <Label text="Next scheduled patient visits"
                                               styleClass="panel-hint"/>
                                    </VBox>
                                    <Label fx:id="upcomingCountLabel"
                                           text="0 appointments"
                                           styleClass="table-count-badge"/>
                                </HBox>
                                <TableView fx:id="appointmentTable"
                                           styleClass="dashboard-table reception-table"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="appointmentTimeColumn"
                                                     text="Date &amp; time"
                                                     prefWidth="112"/>
                                        <TableColumn fx:id="appointmentPatientColumn"
                                                     text="Patient"
                                                     prefWidth="130"/>
                                        <TableColumn fx:id="appointmentDoctorColumn"
                                                     text="Doctor"
                                                     prefWidth="125"/>
                                        <TableColumn fx:id="appointmentStatusColumn"
                                                     text="Status"
                                                     prefWidth="90"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </HBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
