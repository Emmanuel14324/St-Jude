<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ug.sjch.controller.AdminDashboardController"
            styleClass="dashboard-shell">
    <left>
        <StackPane>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="238" spacing="6">
            <HBox styleClass="sidebar-brand" spacing="10">
                <Label text="SJ" styleClass="sidebar-logo"/>
                <VBox>
                    <Label text="SJCH" styleClass="sidebar-name"/>
                    <Label text="Hospital Administration"
                           styleClass="sidebar-caption"/>
                </VBox>
            </HBox>

            <Label text="ADMINISTRATION" styleClass="nav-section"/>
            <Button fx:id="overviewButton" text="▦   Overview"
                    styleClass="nav-button, nav-button-active"
                    onAction="#handleOverview"/>
            <Button fx:id="patientsButton" text="♙   Patients"
                    styleClass="nav-button" onAction="#handlePatients"/>
            <Button fx:id="appointmentsButton" text="▣   Appointments"
                    styleClass="nav-button" onAction="#handleAppointments"/>
            <Button fx:id="staffButton" text="⚕   Staff"
                    styleClass="nav-button" onAction="#handleStaff"/>
            <Button fx:id="usersButton" text="♙   User Accounts"
                    styleClass="nav-button" onAction="#handleUsers"/>
            <Button fx:id="departmentsButton" text="⌂   Departments"
                    styleClass="nav-button" onAction="#handleDepartments"/>
            <Button fx:id="reportsButton" text="▥   Reports"
                    styleClass="nav-button" onAction="#handleReports"/>
            <Button fx:id="auditButton" text="▤   Audit Logs"
                    styleClass="nav-button" onAction="#handleAuditLogs"/>

            <Region VBox.vgrow="ALWAYS"/>
            <HBox styleClass="sidebar-user" spacing="10">
                <Label text="A" styleClass="avatar"/>
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="userLabel" text="Administrator"
                           styleClass="sidebar-user-name"/>
                    <Label text="Active session"
                           styleClass="sidebar-user-status"/>
                </VBox>
            </HBox>
            <Button text="⇥   Sign out" styleClass="logout-button"
                    onAction="#handleLogout"/>
        </VBox>
        <Region fx:id="sidebarResizeHandle"
                styleClass="sidebar-resize-handle"
                StackPane.alignment="CENTER_RIGHT"/>
        </StackPane>
    </left>

    <center>
        <VBox styleClass="workspace">
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="14">
                <Label text="Administration" styleClass="top-user-name"
                       HBox.hgrow="ALWAYS"/>
                <Button text="↻" styleClass="reception-refresh-button"
                        onAction="#handleRefresh"/>
                <Label fx:id="statusLabel" text="Connecting..."
                       styleClass="status-badge"/>
                <Label fx:id="dateLabel" styleClass="top-user-role"/>
            </HBox>
            <ScrollPane fx:id="contentScroll" fitToWidth="true"
                        styleClass="dashboard-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="dashboardContent"
                          styleClass="dashboard-content" spacing="16">
                        <Label text="Loading administration overview..."
                               styleClass="page-title"/>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
