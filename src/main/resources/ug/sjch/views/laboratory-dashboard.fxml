<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ug.sjch.controller.LaboratoryDashboardController"
            styleClass="dashboard-shell laboratory-shell">
    <left>
        <StackPane>
        <VBox fx:id="sidebar" styleClass="sidebar"
              prefWidth="238" spacing="6">
            <HBox styleClass="sidebar-brand" spacing="10">
                <Label text="⚗" styleClass="sidebar-logo"/>
                <VBox>
                    <Label text="SJCH" styleClass="sidebar-name"/>
                    <Label text="Laboratory" styleClass="sidebar-caption"/>
                </VBox>
            </HBox>

            <Label text="LABORATORY" styleClass="nav-section"/>
            <Button fx:id="dashboardButton" text="▦   Dashboard"
                    styleClass="nav-button, nav-button-active"
                    onAction="#showDashboard"/>
            <Button fx:id="testRequestsButton" text="▤   Test Requests"
                    styleClass="nav-button"
                    onAction="#showTestRequests"/>
            <Button fx:id="sampleCollectionButton"
                    text="♧   Sample Collection"
                    styleClass="nav-button"
                    onAction="#showSampleCollection"/>
            <Button fx:id="testsInProgressButton"
                    text="◷   Tests in Progress"
                    styleClass="nav-button"
                    onAction="#showTestsInProgress"/>
            <Button fx:id="enterResultsButton" text="✎   Enter Results"
                    styleClass="nav-button"
                    onAction="#showEnterResults"/>
            <Button fx:id="verifyResultsButton" text="✓   Verify Results"
                    styleClass="nav-button"
                    onAction="#showVerifyResults"/>
            <Button fx:id="historyButton" text="◴   Laboratory History"
                    styleClass="nav-button"
                    onAction="#showHistory"/>
            <Button fx:id="printResultsButton" text="▣   Print Results"
                    styleClass="nav-button"
                    onAction="#showPrintResults"/>
            <Button fx:id="reportsButton" text="▥   Laboratory Reports"
                    styleClass="nav-button"
                    onAction="#showReports"/>

            <Region VBox.vgrow="ALWAYS"/>
            <HBox styleClass="sidebar-user" spacing="10">
                <Label text="LT" styleClass="avatar"/>
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="sidebarUserLabel"
                           styleClass="sidebar-user-name"/>
                    <Label fx:id="sidebarRoleLabel"
                           styleClass="sidebar-user-status"/>
                </VBox>
            </HBox>
            <Button fx:id="logoutButton" text="⇥   Sign out"
                    styleClass="logout-button"
                    onAction="#handleLogout"/>
        </VBox>
        <Region fx:id="sidebarResizeHandle"
                styleClass="sidebar-resize-handle"
                StackPane.alignment="CENTER_RIGHT"/>
        </StackPane>
    </left>

    <center>
        <VBox styleClass="workspace">
            <HBox styleClass="topbar"
                  alignment="CENTER_LEFT" spacing="12">
                <TextField fx:id="searchField" promptText="Search tests..."
                           styleClass="top-search laboratory-search"
                           onAction="#searchRequests" HBox.hgrow="ALWAYS"/>
                <Button fx:id="pendingRequestsAction"
                        text="Pending Requests"
                        styleClass="laboratory-filter-button"
                        onAction="#showTestRequests"/>
                <Button fx:id="awaitingVerificationAction"
                        text="Awaiting Review"
                        styleClass="laboratory-filter-button"
                        onAction="#showVerifyResults"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="refreshButton" text="Refresh"
                        styleClass="laboratory-secondary-button"
                        onAction="#refreshDashboardAction"/>
                <Button fx:id="topEnterResultsButton" text="Enter Results"
                        styleClass="laboratory-primary-button"
                        onAction="#showEnterResults"/>
                <Button fx:id="topReportsButton" text="Reports"
                        styleClass="laboratory-secondary-button"
                        onAction="#showReports"/>
                <Label text="LT" styleClass="laboratory-profile-dot"/>
                <VBox spacing="1">
                    <Label fx:id="topUserLabel" styleClass="top-user-name"/>
                    <Label fx:id="topRoleLabel"
                           styleClass="top-user-role"/>
                </VBox>
            </HBox>

            <ScrollPane fx:id="contentScroll" fitToWidth="true"
                        styleClass="dashboard-scroll"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="dashboardContent"
                          styleClass="dashboard-content laboratory-content"
                          spacing="14">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox HBox.hgrow="ALWAYS" spacing="3">
                                <Label text="Laboratory Information Dashboard"
                                       styleClass="page-title"/>
                                <Label text="Manage test orders, results, and laboratory workflow"
                                       styleClass="page-subtitle"/>
                                <Label fx:id="dateLabel"
                                       styleClass="page-subtitle"/>
                            </VBox>
                            <Label fx:id="statusLabel" text="Loading..."
                                   styleClass="status-badge"/>
                        </HBox>

                        <GridPane styleClass="metrics-grid laboratory-metrics"
                                  hgap="16" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>
                            <VBox styleClass="metric-card laboratory-metric-card laboratory-card-blue"
                                  maxWidth="Infinity" GridPane.hgrow="ALWAYS"
                                  GridPane.columnIndex="0">
                                <Label text="⚗" styleClass="laboratory-metric-icon"/>
                                <Label fx:id="pendingRequestsValue" text="Loading..."
                                       styleClass="laboratory-metric-value"/>
                                <Label text="Pending test requests"
                                       styleClass="metric-label"/>
                            </VBox>
                            <VBox styleClass="metric-card laboratory-metric-card laboratory-card-purple"
                                  maxWidth="Infinity" GridPane.hgrow="ALWAYS"
                                  GridPane.columnIndex="1">
                                <Label text="♧" styleClass="laboratory-metric-icon"/>
                                <Label fx:id="samplesCollectedValue" text="Loading..."
                                       styleClass="laboratory-metric-value"/>
                                <Label text="Samples collected"
                                       styleClass="metric-label"/>
                            </VBox>
                            <VBox styleClass="metric-card laboratory-metric-card laboratory-card-amber"
                                  maxWidth="Infinity" GridPane.hgrow="ALWAYS"
                                  GridPane.columnIndex="2">
                                <Label text="◷" styleClass="laboratory-metric-icon"/>
                                <Label fx:id="testsInProgressValue" text="Loading..."
                                       styleClass="laboratory-metric-value"/>
                                <Label text="Tests in progress"
                                       styleClass="metric-label"/>
                            </VBox>
                            <VBox styleClass="metric-card laboratory-metric-card laboratory-card-green"
                                  maxWidth="Infinity" GridPane.hgrow="ALWAYS"
                                  GridPane.columnIndex="3">
                                <Label text="✓" styleClass="laboratory-metric-icon"/>
                                <Label fx:id="completedTestsValue" text="Loading..."
                                       styleClass="laboratory-metric-value"/>
                                <Label text="Completed tests"
                                       styleClass="metric-label"/>
                            </VBox>
                            <VBox styleClass="metric-card laboratory-metric-card laboratory-card-red"
                                  maxWidth="Infinity" GridPane.hgrow="ALWAYS"
                                  GridPane.columnIndex="0"
                                  GridPane.rowIndex="1">
                                <Label text="!" styleClass="laboratory-metric-icon"/>
                                <Label fx:id="awaitingVerificationValue"
                                       text="Loading..."
                                       styleClass="laboratory-metric-value"/>
                                <Label text="Results awaiting verification"
                                       styleClass="metric-label"/>
                            </VBox>
                        </GridPane>

                        <VBox styleClass="panel laboratory-requests-panel"
                              spacing="10">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="Laboratory test requests"
                                           styleClass="panel-title"/>
                                    <Label text="Requests, samples, and result status"
                                           styleClass="panel-hint"/>
                                </VBox>
                                <Label fx:id="requestCountLabel"
                                       text="Loading..."
                                       styleClass="table-count-badge"/>
                            </HBox>
                            <Label fx:id="requestFeedbackLabel"
                                   styleClass="admin-feedback"
                                   wrapText="true"/>
                            <TableView fx:id="requestTable"
                                       styleClass="dashboard-table laboratory-table"
                                       VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="requestIdColumn"
                                                 text="Request" prefWidth="90"/>
                                    <TableColumn fx:id="patientColumn"
                                                 text="Patient" prefWidth="200"/>
                                    <TableColumn fx:id="testColumn"
                                                 text="Test" prefWidth="180"/>
                                    <TableColumn fx:id="requestedColumn"
                                                 text="Requested" prefWidth="150"/>
                                    <TableColumn fx:id="statusColumn"
                                                 text="Status" prefWidth="130"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
