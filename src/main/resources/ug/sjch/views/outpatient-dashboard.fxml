<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ug.sjch.controller.OutpatientDashboardController"
            styleClass="dashboard-shell outpatient-shell">
    <left>
        <StackPane>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="238" spacing="6">
            <HBox styleClass="sidebar-brand" spacing="10">
                <Label text="✚" styleClass="sidebar-logo"/>
                <VBox>
                    <Label text="ST JUDE" styleClass="sidebar-name"/>
                    <Label text="OUTPATIENT CLINIC" styleClass="sidebar-caption"/>
                </VBox>
            </HBox>

            <Label text="CLINICAL WORKSPACE" styleClass="nav-section"/>
            <Button fx:id="dashboardButton" text="▦   Dashboard"
                    styleClass="nav-button, nav-button-active"
                    onAction="#handleDashboard"/>
            <Button fx:id="patientQueueButton" text="◷   Patient Queue"
                    styleClass="nav-button"
                    onAction="#handlePatientQueue"/>
            <Button fx:id="patientRecordsButton"
                    text="♙   Patient Medical Records"
                    styleClass="nav-button"
                    onAction="#handlePatientRecords"/>
            <Button fx:id="startConsultationButton"
                    text="⚕   Start Consultation"
                    styleClass="nav-button"
                    onAction="#handleStartConsultation"/>
            <Button fx:id="diagnosisButton" text="✚   Diagnosis"
                    styleClass="nav-button"
                    onAction="#handleDiagnosis"/>
            <Button fx:id="completeConsultationButton"
                    text="✓   Complete Consultation"
                    styleClass="nav-button"
                    onAction="#handleCompleteConsultation"/>
            <Button fx:id="prescriptionsButton" text="▤   Prescriptions"
                    styleClass="nav-button"
                    onAction="#handlePrescriptions"/>
            <Button fx:id="laboratoryRequestsButton"
                    text="⚗   Laboratory Requests"
                    styleClass="nav-button"
                    onAction="#handleLaboratoryRequests"/>
            <Button fx:id="consultationHistoryButton"
                    text="▥   Consultation History"
                    styleClass="nav-button"
                    onAction="#handleConsultationHistory"/>
            <Button fx:id="followUpManagementButton"
                    text="▣   Follow-up Management"
                    styleClass="nav-button"
                    onAction="#handleFollowUpManagement"/>

            <Region VBox.vgrow="ALWAYS"/>
            <HBox styleClass="sidebar-user" spacing="9">
                <Label text="MD" styleClass="avatar"/>
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="sidebarUserLabel"
                           styleClass="sidebar-user-name"/>
                    <Label fx:id="sidebarRoleLabel"
                           styleClass="sidebar-user-status"/>
                </VBox>
            </HBox>
            <Button text="⇥   Sign out" styleClass="logout-button"
                    onAction="#handleLogout"/>
        </VBox>
        <Region fx:id="sidebarResizeHandle"
                styleClass="sidebar-resize-handle"
                StackPane.alignment="CENTER_RIGHT"/>
        </StackPane>
    </left>

    <center>
        <VBox styleClass="workspace">
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="14">
                <TextField fx:id="searchField"
                           promptText="Search patients in today's clinical lists..."
                           styleClass="top-search" HBox.hgrow="ALWAYS"/>
                <Button text="↻" styleClass="reception-refresh-button"
                        onAction="#handleRefresh"/>
                <Label text="●" styleClass="notification-icon"/>
                <Label text="MD" styleClass="profile-dot"/>
                <VBox spacing="1">
                    <Label fx:id="topUserLabel" styleClass="top-user-name"/>
                    <Label fx:id="topRoleLabel" styleClass="top-user-role"/>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="dashboard-scroll"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox styleClass="dashboard-content outpatient-content"
                          spacing="14">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox HBox.hgrow="ALWAYS" spacing="3">
                                <Label text="Outpatient Clinical Dashboard"
                                       styleClass="page-title"/>
                                <Label fx:id="dateLabel"
                                       styleClass="page-subtitle"/>
                            </VBox>
                            <Label fx:id="statusLabel" text="Loading..."
                                   styleClass="status-badge"/>
                        </HBox>

                        <GridPane fx:id="metricGrid"
                                  styleClass="metrics-grid outpatient-metrics"
                                  hgap="16" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>
                        </GridPane>

                        <HBox spacing="12" styleClass="outpatient-section-row">
                            <VBox styleClass="panel outpatient-main-panel"
                                  HBox.hgrow="ALWAYS" spacing="8">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Patients waiting for consultation"
                                               styleClass="panel-title"/>
                                        <Label text="Checked-in patients assigned to your clinic"
                                               styleClass="panel-hint"/>
                                    </VBox>
                                    <Label fx:id="queueCountLabel" text="0 patients"
                                           styleClass="table-count-badge"/>
                                </HBox>
                                <TableView fx:id="queueTable"
                                           styleClass="dashboard-table outpatient-table"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="queueNumberColumn"
                                                     text="Patient No."
                                                     prefWidth="105"/>
                                        <TableColumn fx:id="queuePatientColumn"
                                                     text="Patient"
                                                     prefWidth="160"/>
                                        <TableColumn fx:id="queueTimeColumn"
                                                     text="Arrival / visit"
                                                     prefWidth="112"/>
                                        <TableColumn fx:id="queueStatusColumn"
                                                     text="Status"
                                                     prefWidth="92"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox styleClass="panel outpatient-main-panel"
                                  HBox.hgrow="ALWAYS" spacing="8">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Today's consultations"
                                               styleClass="panel-title"/>
                                        <Label text="Consultations in progress and completed"
                                               styleClass="panel-hint"/>
                                    </VBox>
                                    <Label fx:id="consultationCountLabel"
                                           text="0 consultations"
                                           styleClass="table-count-badge"/>
                                </HBox>
                                <TableView fx:id="consultationTable"
                                           styleClass="dashboard-table outpatient-table"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="consultationNumberColumn"
                                                     text="Patient No."
                                                     prefWidth="105"/>
                                        <TableColumn fx:id="consultationPatientColumn"
                                                     text="Patient"
                                                     prefWidth="160"/>
                                        <TableColumn fx:id="consultationTimeColumn"
                                                     text="Time"
                                                     prefWidth="112"/>
                                        <TableColumn fx:id="consultationStatusColumn"
                                                     text="Status"
                                                     prefWidth="92"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </HBox>

                        <HBox spacing="12" styleClass="outpatient-section-row">
                            <VBox styleClass="panel outpatient-support-panel"
                                  HBox.hgrow="ALWAYS" spacing="8">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Follow-up appointments"
                                               styleClass="panel-title"/>
                                        <Label text="Scheduled follow-up visits"
                                               styleClass="panel-hint"/>
                                    </VBox>
                                    <Label fx:id="followUpCountLabel"
                                           text="—"
                                           styleClass="table-count-badge"/>
                                </HBox>
                                <Button fx:id="cancelFollowUpButton"
                                        text="Cancel selected follow-up"
                                        styleClass="laboratory-secondary-button"
                                        onAction="#handleCancelFollowUp"/>
                                <TableView fx:id="followUpTable"
                                           styleClass="dashboard-table outpatient-table"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="followUpNumberColumn"
                                                     text="Patient No."
                                                     prefWidth="100"/>
                                        <TableColumn fx:id="followUpPatientColumn"
                                                     text="Patient"
                                                     prefWidth="145"/>
                                        <TableColumn fx:id="followUpDateColumn"
                                                     text="Follow-up date"
                                                     prefWidth="145"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox styleClass="panel outpatient-support-panel"
                                  HBox.hgrow="ALWAYS" spacing="8">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Pending laboratory requests"
                                               styleClass="panel-title"/>
                                        <Label text="Requested investigations awaiting results"
                                               styleClass="panel-hint"/>
                                    </VBox>
                                    <Label fx:id="laboratoryCountLabel"
                                           text="—"
                                           styleClass="table-count-badge"/>
                                </HBox>
                                <HBox spacing="8">
                                    <Button fx:id="editLaboratoryRequestButton"
                                            text="Edit selected request"
                                            styleClass="laboratory-secondary-button"
                                            onAction="#handleEditLaboratoryRequest"/>
                                    <Button fx:id="cancelLaboratoryRequestButton"
                                            text="Cancel selected request"
                                            styleClass="laboratory-secondary-button"
                                            onAction="#handleCancelLaboratoryRequest"/>
                                </HBox>
                                <TableView fx:id="laboratoryTable"
                                           styleClass="dashboard-table outpatient-table"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="laboratoryNumberColumn"
                                                     text="Patient No."
                                                     prefWidth="100"/>
                                        <TableColumn fx:id="laboratoryPatientColumn"
                                                     text="Patient"
                                                     prefWidth="130"/>
                                        <TableColumn fx:id="laboratoryTestColumn"
                                                     text="Investigation"
                                                     prefWidth="130"/>
                                        <TableColumn fx:id="laboratoryStatusColumn"
                                                     text="Status"
                                                     prefWidth="90"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </HBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
